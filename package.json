{
  "name": "lifekernel-os",
  "version": "0.5.0",
  "private": true,
  "description": "LifeKernel OS：目标期望、当前行动与个人画像。",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.mjs",
    "dev:api": "node --import tsx --watch apps/api/src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "docs:check": "node scripts/check-doc-links.mjs",
    "build": "npm run typecheck && vite build && npm run build:desktop",
    "start": "electron .",
    "db:seed": "node --import tsx apps/api/src/seed.ts",
    "test": "node --import tsx --test apps/api/src/*.test.ts apps/web/src/*.test.tsx apps/desktop/src/*.test.ts",
    "test:web": "node --import tsx --test apps/web/src/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "dev:legacy": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "build:desktop": "node scripts/build-desktop.mjs",
    "start:legacy": "node --import tsx apps/api/src/server.ts",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir",
    "preview:desktop": "node --import tsx scripts/preview-desktop.ts",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.6",
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist-desktop/main.cjs",
  "author": "LifeKernelOS",
  "build": {
    "appId": "com.lifekernel.desktop",
    "productName": "LifeKernelOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "db/migrations/**/*",
      "public/brand/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "public/brand/lifekernel-icon.png"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
